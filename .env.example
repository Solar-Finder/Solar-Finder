# Vorlage für docker compose – kopieren nach .env und anpassen.

# Adresse, unter der die Website im Browser aufgerufen wird (für CORS im Backend), kommagetrennt
CORS_ORIGINS=https://pv.example.de

# Adresse der API aus Sicht des Browsers (wird beim Bauen des Frontends fest eingebaut!)
# Leer lassen = gleicher Hostname wie die Website, Port 8000
NEXT_PUBLIC_API_URL=https://pv-api.example.de/api/v1

# Ports auf dem Host
FRONTEND_PORT=3000
BACKEND_PORT=8000
